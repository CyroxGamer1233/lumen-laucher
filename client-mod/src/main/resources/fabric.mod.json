{
  "schemaVersion": 1,
  "id": "lumen",
  "version": "${version}",
  "name": "Lumen Client",
  "description": "Lightweight FPS, CPS, keystrokes, armor and potion HUD, local skin support, and low-end graphics presets.",
  "authors": [
    "Lumen Team"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.lumen.client.LumenClient"
    ]
  },
  "mixins": [
    "lumen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
